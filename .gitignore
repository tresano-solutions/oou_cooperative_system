deploy/vps/docker-compose.override.yml
deploy/vps/Caddyfile
deploy/vps/backups/

# Personal command cheat-sheet (contains server IP) — keep local
deploy/vps/COMMANDS.txt

deploy/vps/.backup-remote

deploy/vps/.landing-domain

# ── Kept out of the EAS build archive ─────────────────────────────────────────
# EAS Build honours only this root .gitignore, not nested ones, and it does not
# stop at nested git repositories. Without these three lines it uploaded 40 MB
# of virtualenv and agent worktree to build an 820 KB app.
functions/venv/
.claude/worktrees/
.codex/

# Release APK served from the landing site. Build output, not source — it is
# copied to the server directly (see deploy/vps/landing/app/README.txt).
deploy/vps/landing/download/*.apk
deploy/vps/landing/download/*.aab
private_uploads/
